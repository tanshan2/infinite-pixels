{
  "name": "zhiheng",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:single": "VITE_EMBED=true vite build --outDir dist-single && node scripts/inline-single.mjs",
    "build:server": "tsc -p server/tsconfig.json && vite build --ssr server/start.ts --outDir dist-server",
    "start:server": "node --env-file-if-exists=.env.server dist-server/start.js"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
